---
// 運営者情報・プライバシーポリシーのような、ツール以外のページ。
import Base from "./Base.astro";

interface Props {
  title: string;
  description: string;
  path: string;
  /** パンくずとページ名 */
  name: string;
  /** 画面のパンくずに出す名前（name と違うときだけ） */
  crumb?: string;
}

const { title, description, path, name, crumb = name } = Astro.props;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "くらしと仕事の計算ツール", item: new URL("/", Astro.site).href },
    { "@type": "ListItem", position: 2, name, item: new URL(path, Astro.site).href },
  ],
};
---
<Base title={title} description={description} path={path} jsonLd={jsonLd} crumb={crumb}>
  <slot name="header" slot="header" />
  <slot />
</Base>
