---
// 全ページ共通の head・サイトバー・パンくず・フッター。
interface Props {
  title: string;
  description?: string;
  /** "/kyuyo/" のようなページのパス。canonical と OGP の URL になる */
  path?: string;
  ogType?: "website" | "article";
  jsonLd?: object;
  /** パンくずに出す今のページ名。トップと404では出さない */
  crumb?: string;
  headerClass?: string;
  /** フッターに「入力内容は送信されない」の一文を出す（ツールのページ） */
  privacyNote?: boolean;
  /** 検索結果に出さない（404） */
  noindex?: boolean;
}

const { title, description, path, ogType = "article", jsonLd, crumb, headerClass, privacyNote = false, noindex = false } = Astro.props;
const SITE_NAME = "くらしと仕事の計算ツール";
const url = path && new URL(path, Astro.site).href;
const ogImage = new URL("/assets/ogp.png", Astro.site).href;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  {description && <meta name="description" content={description}>}
  {noindex && <meta name="robots" content="noindex">}
  {url && <link rel="canonical" href={url}>}
  <meta name="theme-color" content="#2563eb">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  {url && (
    <>
      <meta property="og:type" content={ogType}>
      <meta property="og:site_name" content={SITE_NAME}>
      <meta property="og:locale" content="ja_JP">
      <meta property="og:title" content={title}>
      <meta property="og:description" content={description}>
      <meta property="og:url" content={url}>
      <meta property="og:image" content={ogImage}>
      <meta property="og:image:width" content="1200">
      <meta property="og:image:height" content="630">
      <meta name="twitter:card" content="summary_large_image">
    </>
  )}
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd, null, 2)} />}
  <script is:inline src="/assets/theme.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;700;900&display=swap">
  <link rel="stylesheet" href="/assets/style.css">
</head>
<body>
  <div class="site-bar">
    <div class="site-bar-inner">
      <a class="logo" href="/"><span class="logo-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="3"/><path d="M8.5 7.5h7M8.5 12h1M11.5 12h1M14.5 12h1M8.5 15.5h1M11.5 15.5h1M14.5 15.5h1"/></svg></span>{SITE_NAME}</a>
      <button type="button" class="theme-toggle" aria-label="ライト／ダークを切り替える" title="ライト／ダークを切り替える"><svg class="icon-moon" viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg><svg class="icon-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
    </div>
  </div>
  <header class={headerClass}>
    {crumb && <nav class="crumbs" aria-label="パンくずリスト"><a href="/">トップ</a><span aria-hidden="true">›</span><span>{crumb}</span></nav>}
    <slot name="header" />
  </header>
  <main>
    <slot />
  </main>
  <footer>
    {privacyNote && <p>計算は入力した端末の中だけで行い、入力内容はどこにも送信されません。</p>}
    <nav class="footer-nav"><a href="/">計算ツール一覧</a><a href="/about/">運営者情報</a><a href="/privacy/">プライバシーポリシー</a></nav>
  </footer>
</body>
</html>
