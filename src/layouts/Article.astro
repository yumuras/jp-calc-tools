---
// 解説記事のページ。親のツールの下に置き、パンくずは3階層（トップ › ツール › 記事）。
import Base from "./Base.astro";
import { toolBySlug } from "../data/tools.js";

interface Props {
  /** 親のツールの slug（例: "denkidai"） */
  parent: string;
  /** 記事の slug（URL は /<parent>/<slug>/） */
  slug: string;
  title: string;
  description: string;
  /** パンくず・構造化データでの記事名 */
  name: string;
  published: string;
  updated: string;
}

const { parent, slug, title, description, name, published, updated } = Astro.props;
const tool = toolBySlug(parent);
if (!tool) throw new Error(`unknown tool: ${parent}`);
const path = `/${parent}/${slug}/`;
const site = (p: string) => new URL(p, Astro.site).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: title,
      description,
      url: site(path),
      inLanguage: "ja",
      datePublished: published,
      dateModified: updated,
      author: { "@type": "Person", name: "くらしと仕事の計算ツール 運営者", url: site("/about/") },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "くらしと仕事の計算ツール", item: site("/") },
        { "@type": "ListItem", position: 2, name: tool.name, item: site(`/${parent}/`) },
        { "@type": "ListItem", position: 3, name, item: site(path) },
      ],
    },
  ],
};
const [y, m, d] = updated.split("-").map(Number);
---
<Base title={title} description={description} path={path} jsonLd={jsonLd}>
  <Fragment slot="header">
    <nav class="crumbs" aria-label="パンくずリスト"><a href="/">トップ</a><span aria-hidden="true">›</span><a href={`/${parent}/`}>{tool.name}</a><span aria-hidden="true">›</span><span>{name}</span></nav>
    <slot name="header" />
  </Fragment>
  <slot />
  <p class="lead">最終更新：<time datetime={updated}>{y}年{m}月{d}日</time></p>
  <section class="related">
    <h2>関連するページ</h2>
    <ul>
      <slot name="related" />
    </ul>
  </section>
</Base>
