---
import Tool from "../../layouts/Tool.astro";
---
<Tool
  slug="pdf"
  title="PDFの結合・分割｜ブラウザだけで完結、ファイルを送信しない"
  description="複数のPDFを1つにまとめたり、指定したページだけを抜き出したり、1ページずつに分けたりできます。処理はすべてお使いのブラウザの中で行い、ファイルはどこにも送信しません。"
  name="PDFの結合・分割"
  category="UtilitiesApplication"
  updated="2026-10-29"
>
  <Fragment slot="header">
    <h1>PDFの結合・分割</h1>
    <p class="lead">複数のPDFを1つにまとめたり、必要なページだけを抜き出したりできます。ファイルはどこにも送信せず、ブラウザの中だけで処理します。</p>
  </Fragment>
  <section class="card">
    <h2>PDFを結合する</h2>
    <label for="merge-input">PDFを選ぶ（複数可）</label>
    <input type="file" id="merge-input" accept="application/pdf,.pdf" multiple>
    <ol class="file-list" id="merge-list"></ol>
    <p class="hint">上から順にまとめます。↑↓で順番を入れ替えられます。</p>
    <button type="button" id="merge-run" disabled>結合してダウンロード</button>
    <p class="pdf-status" id="merge-status" role="status"></p>
  </section>

  <section class="card">
    <h2>PDFを分割・ページを抜き出す</h2>
    <label for="split-input">PDFを選ぶ</label>
    <input type="file" id="split-input" accept="application/pdf,.pdf">
    <p class="hint" id="split-info"></p>
    <fieldset class="split-mode">
      <legend>分け方</legend>
      <label><input type="radio" name="mode" value="extract" checked> 指定したページを抜き出す</label>
      <label><input type="radio" name="mode" value="each"> 1ページずつのPDFに分ける</label>
    </fieldset>
    <label for="ranges">ページの指定</label>
    <input type="text" id="ranges" placeholder="例：1-3, 5, 8-" inputmode="numeric">
    <p class="hint">「8-」は8ページ目から最後までです。書いた順に並びます。</p>
    <button type="button" id="split-run" disabled>作成してダウンロード</button>
    <p class="pdf-status" id="split-status" role="status"></p>
    <ul class="file-list" id="split-links"></ul>
  </section>

  <h2>ファイルは送信しません</h2>
  <p>このページは、PDFをお使いのスマホやパソコンの中だけで読み込み、まとめ直します。運営者を含め、どこにもファイルを送りません。契約書や給与明細など、人に見せたくない書類にも使えます。</p>
  <p>処理には、オープンソースのライブラリ <a href="https://pdf-lib.js.org/" rel="noopener">pdf-lib</a>（MITライセンス）を、このサイトの中に置いて使っています。</p>

  <h2>よくある質問</h2>
  <h3>パスワード付きのPDFは使えますか？</h3>
  <p>使えません。パスワードで保護されたPDFは、先にパスワードを解除してから選んでください。</p>
  <h3>ファイルの大きさに上限はありますか？</h3>
  <p>上限は決めていませんが、端末のメモリを使って処理するので、数百MBのような大きなPDFは時間がかかったり、止まったりすることがあります。</p>
  <h3>しおりやリンクは残りますか？</h3>
  <p>ページの中身はそのまま残りますが、しおり（目次）やフォームの入力欄は引き継がれないことがあります。</p>

  <h2>出典・更新日</h2>
  <ul class="sources">
      <li>PDFの処理：<a href="https://github.com/Hopding/pdf-lib" rel="noopener">pdf-lib</a> 1.17.1（MITライセンス）</li>
  </ul>

  <script>
    import { mergePdfs, extractPages, splitEachPage, pageCountOf, parsePageRanges } from "../../lib/pdf.js";

    const $ = (id) => document.getElementById(id);
    const baseName = (name) => name.replace(/\.pdf$/i, "");
    const readFile = async (file) => ({ name: file.name, bytes: new Uint8Array(await file.arrayBuffer()) });

    function download(bytes, filename) {
      const url = URL.createObjectURL(new Blob([bytes], { type: "application/pdf" }));
      const a = document.createElement("a");
      a.href = url;
      a.download = filename;
      document.body.append(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 60000);
    }

    // ---- 結合 ----
    let mergeFiles = [];

    function renderMergeList() {
      const list = $("merge-list");
      list.replaceChildren(...mergeFiles.map((f, i) => {
        const li = document.createElement("li");
        const label = document.createElement("span");
        label.textContent = `${f.name}（${f.pages}ページ）`;
        const buttons = [["↑", -1, "上へ"], ["↓", 1, "下へ"]].map(([text, step, aria]) => {
          const b = document.createElement("button");
          b.type = "button";
          b.className = "remove";
          b.textContent = text;
          b.setAttribute("aria-label", `${f.name}を${aria}`);
          b.disabled = !mergeFiles[i + step];
          b.addEventListener("click", () => {
            [mergeFiles[i], mergeFiles[i + step]] = [mergeFiles[i + step], mergeFiles[i]];
            renderMergeList();
          });
          return b;
        });
        const del = document.createElement("button");
        del.type = "button";
        del.className = "remove";
        del.textContent = "削除";
        del.setAttribute("aria-label", `${f.name}を外す`);
        del.addEventListener("click", () => { mergeFiles.splice(i, 1); renderMergeList(); });
        li.append(label, ...buttons, del);
        return li;
      }));
      $("merge-run").disabled = mergeFiles.length < 2;
    }

    $("merge-input").addEventListener("change", async (e) => {
      $("merge-status").textContent = "";
      for (const file of e.target.files) {
        try {
          const f = await readFile(file);
          f.pages = await pageCountOf(f.bytes, f.name);
          mergeFiles.push(f);
        } catch (err) {
          $("merge-status").textContent = err.message;
        }
      }
      e.target.value = "";
      renderMergeList();
    });

    $("merge-run").addEventListener("click", async () => {
      $("merge-status").textContent = "結合しています…";
      try {
        download(await mergePdfs(mergeFiles), "結合.pdf");
        $("merge-status").textContent = `${mergeFiles.length}個のPDFを1つにまとめました。`;
      } catch (err) {
        $("merge-status").textContent = err.message;
      }
    });

    // ---- 分割・抜き出し ----
    let splitFile = null;
    const mode = () => document.querySelector('input[name="mode"]:checked').value;

    function updateSplitForm() {
      $("ranges").disabled = mode() !== "extract";
      $("split-run").disabled = !splitFile;
    }

    $("split-input").addEventListener("change", async (e) => {
      $("split-status").textContent = "";
      $("split-links").replaceChildren();
      splitFile = null;
      $("split-info").textContent = "";
      const [file] = e.target.files;
      if (file) {
        try {
          splitFile = await readFile(file);
          splitFile.pages = await pageCountOf(splitFile.bytes, splitFile.name);
          $("split-info").textContent = `${splitFile.name}：全${splitFile.pages}ページ`;
        } catch (err) {
          splitFile = null;
          $("split-status").textContent = err.message;
        }
      }
      updateSplitForm();
    });
    document.querySelectorAll('input[name="mode"]').forEach((r) => r.addEventListener("change", updateSplitForm));

    $("split-run").addEventListener("click", async () => {
      const { name, bytes, pages } = splitFile;
      $("split-links").replaceChildren();
      try {
        if (mode() === "extract") {
          const indices = parsePageRanges($("ranges").value, pages);
          download(await extractPages(bytes, indices, name), `${baseName(name)}_抜き出し.pdf`);
          $("split-status").textContent = `${indices.length}ページのPDFを作りました。`;
        } else {
          $("split-status").textContent = "分けています…";
          const parts = await splitEachPage(bytes, name);
          $("split-links").replaceChildren(...parts.map((part, i) => {
            const li = document.createElement("li");
            const a = document.createElement("a");
            a.href = URL.createObjectURL(new Blob([part], { type: "application/pdf" }));
            a.download = `${baseName(name)}_${i + 1}.pdf`;
            a.textContent = a.download;
            li.append(a);
            return li;
          }));
          $("split-status").textContent = `${parts.length}個に分けました。下のリンクから保存してください。`;
        }
      } catch (err) {
        $("split-status").textContent = err.message;
      }
    });

    updateSplitForm();
  </script>
</Tool>
